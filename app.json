{
  "expo": {
    "name": "शिव चर्चा",
    "slug": "shiv-charcha",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "shivcharcha",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahavyomastudio.shivcharcha"
    },
    "android": {
      "package": "com.mahavyomastudio.shivcharcha",
      "supportsTablet": true,
      "resizeableActivity": true,
      "statusBar": {
        "barStyle": "light-content",
        "translucent": true
      },
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#4A0E17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SET_WALLPAPER"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mahavyomastudio.com",
              "pathPrefix": "/shiv-charcha"
            },
            {
              "scheme": "https",
              "host": "mahavyomastudio.com",
              "pathPrefix": "/apps/shiv-charcha"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7433519007687449~3877473665",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A0E17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-repackageclasses ''\n-allowaccessmodification\n-optimizationpasses 5",
            "gradleArgs": [
              "-Dorg.gradle.jvmargs=-Xmx10240m -XX:MaxMetaspaceSize=4096m -XX:+UseG1GC",
              "-Dorg.gradle.parallel=true",
              "-x",
              "lintVitalAnalyzeRelease"
            ]
          }
        }
      ],
      "expo-video"
    ],
    "owner": "mindcraftlearning",
    "updates": {
      "url": "https://u.expo.dev/b0e82df7-7948-47e2-90fd-5c428c8de72e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.5",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0e82df7-7948-47e2-90fd-5c428c8de72e"
      }
    }
  }
}
